# ============================================================
# tpl-manage 环境变量样例（复制为 .env 后填入真实值）
# .env 不入库；本样例仅提供简单占位值
# 加载机制：me.paulschwarz:spring-dotenv
# ============================================================

# JWT 签名密钥（生产必须强随机）
SA_TOKEN_JWT_SECRET=changeMe

# API 接口加密 RSA 公钥/私钥（与前端 VITE_APP_RSA_* 对应，更换需前后端同步）
RSA_PUBLIC_KEY=changeMe
RSA_PRIVATE_KEY=changeMe

# 数据库连接
DB_URL=jdbc:postgresql://localhost:5432/tpl_manage
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Redis 连接
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=postgres

# MinIO
MINIO_SECRET_KEY=minioadmin

# MQTT（默认禁用）
MQTT_PASSWORD=123456
